<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Límites de subida. Sin esto el server acepta 256 MB por request y una tanda de
# mp3 se corta con un 413 "Content Too Large" antes de llegar a Laravel.
#
# Tiene que ser por php_value: en Hostinger `user_ini.filename` viene vacío, o
# sea que el mecanismo de .user.ini está apagado y ese archivo no haría nada.
# Este LiteSpeed sí interpreta las directivas estilo mod_php.
#
# El <IfModule> no es decorativo: si el Apache local (Laragon) corre PHP por
# FastCGI en vez de mod_php, un php_value suelto le tira 500 a todo el sitio.
# LiteSpeed matchea igual este bloque, así que en el server aplica.
#
# hPanel -> Avanzado -> Configuración PHP puede pisar estos valores. La app no
# confía en el número: lo lee con ini_get() y valida contra el efectivo
# (escribelo_upload_limits() en app/helpers.php).
<IfModule mod_php.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 512M
    php_value max_input_time 600
</IfModule>

# PWA. Sin el AddType muchos hostings sirven el manifest como text/plain.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# sw.js y el manifest son por donde el navegador se entera de que hay versión
# nueva: si el CDN de Hostinger los cachea (max-age de 7 días por defecto), las
# actualizaciones no llegan hasta que expire. El Expires de mod_expires se borra
# para que no contradiga al max-age=0.
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header unset Expires
    </FilesMatch>
</IfModule>
